<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.krone.vpn">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- automatische Updates (die App installiert ihre eigene neue Version) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- ab Android 12: eigene Updates OHNE Rueckfrage einspielen (sonst fragt Android jedes Mal nach – und aus dem
         Hintergrund kann die Rueckfrage gar nicht erscheinen) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- ab Android 14: Voraussetzung fuer setRequestUpdateOwnership -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- Hinweis "Update bereit – tippen zum Installieren" (Android 13+ fragt einmal nach) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vordergrund-Dienst mit dauerhafter Benachrichtigung, solange das VPN laeuft ("verbunden", "Standort wird
         geteilt") – so laeuft nichts verdeckt; auch fuer den Neustart nach einem Update -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- fuer "Standort teilen" (Standard an, in der App abschaltbar): WLAN-Name und Standort an den eigenen VPN-Server -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- "Apps am VPN vorbei": Liste der Apps mit Startsymbol (ohne die Berechtigung, alle Pakete zu sehen) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR-Code mit der Kamera scannen oeffnet direkt die App mit dem Verbindungscode -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kronevpn" />
            </intent-filter>
        </activity>

        <service
            android:name=".KroneVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN-Verbindung mit sichtbarer Benachrichtigung (verbunden, Standort-Teilen an/aus)" />
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="true" />
        </service>

        <!-- Schnelleinstellungs-Kachel: VPN an/aus aus der Statusleiste -->
        <service
            android:name=".Kachel"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_kachel"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <receiver android:name=".Updater$Result" android:exported="false" />
        <receiver android:name=".Updater$Replaced" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
